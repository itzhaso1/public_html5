APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database ----
#
# For MySQL (recommended for production), fill these:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# For SQLite (optional for local/testing), you can switch to:
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# One-time data import from legacy SQLite into MySQL:
# SQLITE_LEGACY_DATABASE=C:\path\to\old.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Account image processing
ACCOUNT_IMAGE_TOP_AREA_MODE=blur
ACCOUNT_IMAGE_TOP_AREA_SIZE_PX=35
ACCOUNT_IMAGE_TOP_AREA_WIDTH_PX=0
ACCOUNT_IMAGE_TOP_AREA_WIDTH_RATIO=1
ACCOUNT_IMAGE_TOP_AREA_X_FROM_RIGHT_PX=0
ACCOUNT_IMAGE_TOP_AREA_BLUR_STRENGTH=35
ACCOUNT_IMAGE_NAME_BLUR_ENABLED=true
ACCOUNT_IMAGE_NAME_BLUR_MODE=adaptive
ACCOUNT_IMAGE_NAME_BLUR_X_OFFSET_FROM_RIGHT_RATIO=0.39
ACCOUNT_IMAGE_NAME_BLUR_Y_RATIO=0.037
ACCOUNT_IMAGE_NAME_BLUR_WIDTH_RATIO=0.325
ACCOUNT_IMAGE_NAME_BLUR_HEIGHT_RATIO=0.093
ACCOUNT_IMAGE_NAME_BLUR_X_OFFSET_FROM_RIGHT=420
ACCOUNT_IMAGE_NAME_BLUR_Y=40
ACCOUNT_IMAGE_NAME_BLUR_WIDTH=350
ACCOUNT_IMAGE_NAME_BLUR_HEIGHT=100
ACCOUNT_IMAGE_NAME_BLUR_STRENGTH=35
